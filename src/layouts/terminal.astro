---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/base-head.astro";
import JsonLd from "../components/json-ld.astro";
import NavOverlay from "../components/nav-overlay.astro";
import TerminalTitleBar from "../components/terminal-title-bar.astro";
import TerminalWindow from "../components/terminal-window.astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  home?: boolean;
}

const { title, description, image, type, home = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
    <JsonLd />
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>
    <TerminalWindow>
      <TerminalTitleBar home={home} />
      <div class="px-4 py-8 md:px-8 md:py-10">
        <slot />
      </div>
    </TerminalWindow>
    <NavOverlay home={home} />
    {
      home && (
        <script>
          const sections = document.querySelectorAll<HTMLElement>("section[id]");
          const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

          if (sections.length && links.length) {
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  const id = entry.target.id;
                  for (const link of links) {
                    const active = link.dataset.navLink === id;
                    link.classList.toggle("text-brand", active);
                    link.classList.toggle("text-ink", !active);
                  }
                }
              },
              { rootMargin: "-25% 0px -60% 0px", threshold: 0 },
            );

            sections.forEach((section) => observer.observe(section));
          }
        </script>
      )
    }
  </body>
</html>
