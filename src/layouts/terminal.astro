---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/base-head.astro";
import PageBg from "../components/page-bg.astro";
import JsonLd from "../components/json-ld.astro";
import CommandPalette from "../components/command-palette.astro";
import SiteFooter from "../components/site-footer.astro";
import TerminalTitleBar from "../components/terminal-title-bar.astro";
import TerminalWindow from "../components/terminal-window.astro";
import { SITE_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  home?: boolean;
  activeNav?: string;
  titlePath?: string;
  headline?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  articleTags?: string[];
}

const {
  title,
  description,
  image,
  type,
  home = false,
  activeNav,
  titlePath,
  headline,
  publishedTime,
  modifiedTime,
  articleTags,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const imageURL = image ? new URL(image.src, Astro.site ?? SITE_URL).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <JsonLd
      type={type}
      headline={headline ?? title}
      description={description}
      url={canonicalURL}
      image={imageURL}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={articleTags}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <PageBg />
    <div
      class:list={["scanlines", type === "article" && "scanlines-article"]}
      aria-hidden="true"
    >
    </div>
    <TerminalWindow>
      <TerminalTitleBar home={home} activeNav={activeNav} titlePath={titlePath} />
      <CommandPalette home={home} />
      <div id="main" class="flex-1 px-4 py-8 md:px-8 md:py-10" tabindex="-1">
        <slot />
      </div>
      <SiteFooter />
    </TerminalWindow>
    {
      home && (
        <script>
          const sections = document.querySelectorAll<HTMLElement>("section[id]");
          const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

          if (sections.length && links.length) {
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  const id = entry.target.id;
                  for (const link of links) {
                    const active = link.dataset.navLink === id;
                    link.classList.toggle("text-brand", active);
                    link.classList.toggle("text-ink", !active);
                  }
                }
              },
              { rootMargin: "-25% 0px -60% 0px", threshold: 0 },
            );

            sections.forEach((section) => observer.observe(section));
          }
        </script>
      )
    }
  </body>
</html>
