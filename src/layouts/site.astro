---
import type { ImageMetadata } from "astro";
import BaseHead from "../components/base-head.astro";
import JsonLd from "../components/json-ld.astro";
import CommandPalette from "../components/command-palette.astro";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import { SITE_URL } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  home?: boolean;
  activeNav?: string;
  headline?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  articleTags?: string[];
  robots?: string;
}

const {
  title,
  description,
  image,
  type,
  home = false,
  activeNav,
  headline,
  publishedTime,
  modifiedTime,
  articleTags,
  robots,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href;
const imageURL = image ? new URL(image.src, Astro.site ?? SITE_URL).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      robots={robots}
    />
    <JsonLd
      type={type}
      headline={headline ?? title}
      description={description}
      url={canonicalURL}
      image={imageURL}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={articleTags}
    />
  </head>
  <body class="flex flex-col">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader home={home} activeNav={activeNav} />
    <CommandPalette home={home} />
    <main
      id="main"
      class="mx-auto w-full max-w-308 flex-1 px-4 pb-24 md:px-8"
      tabindex="-1"
    >
      <slot />
    </main>
    <SiteFooter />
    {
      home && (
        <script>
          const sections = document.querySelectorAll<HTMLElement>("section[id]");
          const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

          if (sections.length && links.length) {
            const observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  const id = entry.target.id;
                  for (const link of links) {
                    const active = link.dataset.navLink === id;
                    link.classList.toggle("bg-surface-2", active);
                    link.classList.toggle("text-ink", active);
                    link.classList.toggle("text-muted", !active);
                    if (active) link.setAttribute("aria-current", "location");
                    else link.removeAttribute("aria-current");
                  }
                }
              },
              { rootMargin: "-25% 0px -60% 0px", threshold: 0 },
            );

            sections.forEach((section) => observer.observe(section));
          }
        </script>
      )
    }
  </body>
</html>
