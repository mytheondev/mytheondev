---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import ArticleEnhance from "../components/article-enhance.astro";
import MermaidEnhance from "../components/mermaid-enhance.astro";
import ArticleToc from "../components/article-toc.astro";
import CopyLink from "../components/copy-link.astro";
import FormattedDate from "../components/formatted-date.astro";
import TagList from "../components/tag-list.astro";
import { canonicalSlug, datesDiffer, slugFromId, tocHeadings, type BlogPost } from "../lib/blog";
import { ogImageForSlug } from "../lib/og";
import Layout from "./site.astro";

interface Props {
  post: CollectionEntry<"blog">;
  minutes: number;
  headings: MarkdownHeading[];
  showToc: boolean;
  related: BlogPost[];
  older?: BlogPost;
  newer?: BlogPost;
}

const { post, minutes, headings, showToc, related, older, newer } = Astro.props;
const { title, description, publishedAt, updatedAt, tags, prerequisites } = post.data;
const pageTitle = `${title} — Mytheon`;
const slug = slugFromId(post.id);
const ogSlug = canonicalSlug(post.id);
const showUpdated = datesDiffer(publishedAt, updatedAt);
const toc = tocHeadings(headings);
const hasToc = showToc && toc.length > 0;
const articleUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title={pageTitle}
  headline={title}
  description={description}
  image={ogImageForSlug(ogSlug)}
  type="article"
  activeNav="blog"
  publishedTime={publishedAt}
  modifiedTime={updatedAt}
  articleTags={tags}
>
  <article class="pt-8 md:pt-14">
    <header class="max-w-[820px]">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <a href="/blog/" class="hover:text-brand">Blog</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span class="sr-only">{slug}</span>
      </nav>
      <TagList tags={tags} class="mt-5" />
      <h1
        class="mt-4 font-display text-[34px] leading-[1.08] font-semibold tracking-[-0.03em] text-ink md:text-[52px]"
      >
        {title}
      </h1>
      <p class="mt-5 max-w-[68ch] text-lg leading-relaxed text-muted">{description}</p>
      <p
        class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line pt-5 font-mono text-[13px] text-muted"
      >
        <FormattedDate date={publishedAt} />
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
        {
          showUpdated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <FormattedDate date={updatedAt} />
              </span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <CopyLink url={articleUrl} />
      </p>
      {
        prerequisites && prerequisites.length > 0 && (
          <p class="mt-4 max-w-[68ch] rounded-2xl bg-surface-2 px-4 py-3 text-sm text-muted">
            <span class="font-semibold text-ink">Prerequisites:</span> {prerequisites.join(" · ")}
          </p>
        )
      }
    </header>

    <div
      class:list={[
        "mt-10 md:mt-12",
        hasToc &&
          "lg:grid lg:grid-cols-[minmax(0,68ch)_minmax(14rem,1fr)] lg:items-start lg:gap-12",
      ]}
    >
      {hasToc && <ArticleToc headings={toc} />}

      <div class:list={[hasToc && "min-w-0 lg:col-start-1 lg:row-start-1"]}>
        <div class="article-body">
          <slot />
        </div>

        {
          (older || newer || related.length > 0) && (
            <nav class="mt-14 max-w-[68ch] border-t border-line pt-8" aria-label="More articles">
              {(older || newer) && (
                <div class="grid gap-3 sm:grid-cols-2">
                  {older ? (
                    <a
                      href={`/blog/${older.id}/`}
                      class="card-hover rounded-2xl border border-line bg-surface p-5"
                    >
                      <p class="eyebrow">← Previous</p>
                      <p class="mt-2 font-display text-base leading-snug font-semibold text-ink">
                        {older.data.title}
                      </p>
                    </a>
                  ) : (
                    <span />
                  )}
                  {newer && (
                    <a
                      href={`/blog/${newer.id}/`}
                      class="card-hover rounded-2xl border border-line bg-surface p-5 sm:text-right"
                    >
                      <p class="eyebrow">Next →</p>
                      <p class="mt-2 font-display text-base leading-snug font-semibold text-ink">
                        {newer.data.title}
                      </p>
                    </a>
                  )}
                </div>
              )}
              {related.length > 0 && (
                <div class={older || newer ? "mt-10" : ""}>
                  <p class="eyebrow">Related</p>
                  <ul class="mt-3 space-y-2">
                    {related.map((item) => (
                      <li>
                        <a
                          href={`/blog/${item.id}/`}
                          class="text-[15px] text-ink underline decoration-line-strong underline-offset-4 hover:text-brand hover:decoration-brand"
                        >
                          {item.data.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </nav>
          )
        }

        <p class="mt-12 max-w-[68ch]">
          <a href="/blog/" class="pill-link">← Back to blog</a>
        </p>
      </div>
    </div>
  </article>
  <ArticleEnhance />
  <MermaidEnhance />
</Layout>
