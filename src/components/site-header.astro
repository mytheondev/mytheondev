---
import LogoMark from "./logo-mark.astro";
import ThemeToggle from "./theme-toggle.astro";
import { NAV_ITEMS, navHref } from "../lib/site";

interface Props {
  home?: boolean;
  activeNav?: string;
}

const { home = false, activeNav } = Astro.props;
const navItems = NAV_ITEMS.filter((item) => item.id !== "contact");
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-transparent bg-bg/85 backdrop-blur-md transition-transform duration-300 ease-out"
>
  <!-- tw: -translate-y-full -->
  <div class="mx-auto flex h-16 max-w-[1232px] items-center gap-2 px-4 md:h-20 md:px-8">
    <a href="/" class="flex flex-1 items-center gap-2.5 lg:flex-none" aria-label="Mytheon — home">
      <LogoMark class="size-9 shrink-0" />
      <span class="font-display text-lg font-semibold tracking-tight text-ink md:text-xl"
        >Mytheon</span
      >
    </a>

    <nav
      class="mx-auto hidden items-center gap-0.5 rounded-full border border-line bg-surface p-1 text-sm lg:flex"
      aria-label="Primary"
    >
      {
        navItems.map((item) => {
          const active = activeNav === item.id;
          return (
            <a
              href={navHref(item.id, home)}
              data-nav-link={item.id}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3.5 py-2 capitalize transition-colors hover:text-ink",
                active ? "bg-surface-2 font-medium text-ink" : "text-muted",
              ]}
            >
              {item.id === "github" ? "GitHub" : item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="palette-toggle"
        class="relative z-50 flex size-11 cursor-pointer items-center justify-center gap-2 rounded-full border border-line bg-surface text-xs text-muted transition-colors hover:border-line-strong hover:text-ink lg:h-10 lg:w-auto lg:px-3.5"
        aria-label="Search or jump to"
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="command-palette"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <kbd data-palette-kbd class="hidden font-mono text-[11px] tracking-wide lg:inline">Ctrl K</kbd>
      </button>
      <ThemeToggle />
      <a
        href={navHref("contact", home)}
        class="hidden h-10 items-center rounded-full bg-brand px-4.5 text-sm font-semibold text-on-brand transition-[filter] hover:brightness-110 lg:flex"
      >
        Contact
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("palette-toggle");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (header) {
    let lastY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      header.classList.toggle("border-line", y > 8);
      header.classList.toggle("border-transparent", y <= 8);

      if (reduceMotion) return;

      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";

      if (menuOpen || y < 16) {
        header.classList.remove("-translate-y-full");
        lastY = y;
        return;
      }

      if (Math.abs(y - lastY) < 8) return;

      header.classList.toggle("-translate-y-full", y > lastY);
      lastY = y;
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
