<button
  type="button"
  data-theme-toggle
  class="flex size-11 cursor-pointer items-center justify-center rounded-full border border-line bg-surface text-ink transition-colors hover:border-line-strong lg:size-10"
  aria-label="Toggle color theme"
>
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const system = window.matchMedia("(prefers-color-scheme: dark)");

  const current = (): Theme => (root.dataset.theme === "dark" ? "dark" : "light");

  const stored = (): Theme | null => {
    try {
      const value = localStorage.getItem("theme");
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  };

  const syncLabels = () => {
    const next = current() === "dark" ? "light" : "dark";
    for (const button of buttons) {
      button.setAttribute("aria-label", `Switch to ${next} mode`);
    }
  };

  const apply = (theme: Theme) => {
    if (theme === current()) return;
    root.dataset.theme = theme;
    syncLabels();
    document.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next: Theme = current() === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Private mode or blocked storage: the choice lasts for this page only.
      }
      apply(next);
    });
  }

  system.addEventListener("change", (event) => {
    if (stored()) return;
    apply(event.matches ? "dark" : "light");
  });

  syncLabels();
</script>
