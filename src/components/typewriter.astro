---
interface Props {
  text: string;
  as?: "h1" | "p" | "span";
  class?: string;
}

const { text, as: Tag = "h1", class: className = "" } = Astro.props;
---

<Tag class:list={["block", className]} data-typewriter={text}>
  <span data-typewriter-text>{text}</span>
  <span class="cursor-blink h-10! md:h-16!" aria-hidden="true"></span>
</Tag>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nodes = document.querySelectorAll<HTMLElement>("[data-typewriter]");

  for (const node of nodes) {
    const full = node.dataset.typewriter ?? "";
    const target = node.querySelector<HTMLElement>("[data-typewriter-text]");
    if (!target) continue;
    if (reduceMotion) continue;

    let index = 0;
    const tick = () => {
      target.textContent = full.slice(0, index);
      index += 1;
      if (index <= full.length) {
        window.setTimeout(tick, 55);
      }
    };
    tick();
  }
</script>
