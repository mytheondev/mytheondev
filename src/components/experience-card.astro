---
interface Props {
  role: string;
  company: string;
  dates: string;
  description: string;
  stack: string[];
}

const { role, company, dates, description, stack } = Astro.props;
---

<article class="rounded-lg border border-white/10 p-5 md:p-6">
  <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
    <h3 class="font-semibold text-ink">
      {role} — {company}
    </h3>
    <p class="text-sm text-brand">{dates}</p>
  </div>
  <p class="mt-4 text-sm leading-relaxed text-muted">{description}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      stack.map((item) => (
        <li class="rounded-md border border-white/10 px-2 py-1 text-xs text-ink">{item}</li>
      ))
    }
  </ul>
</article>
