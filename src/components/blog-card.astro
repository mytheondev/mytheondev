---
import FormattedDate from "./formatted-date.astro";
import TagList from "./tag-list.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  publishedAt: Date;
  minutes: number;
  tags: string[];
}

const { href, title, description, publishedAt, minutes, tags } = Astro.props;
---

<article
  class="card-hover group relative flex h-full flex-col gap-3.5 rounded-3xl border border-line bg-surface p-6 md:p-7"
>
  <TagList tags={tags} />
  <h3 class="font-display text-xl leading-snug font-semibold tracking-tight md:text-[22px]">
    <a href={href} class="text-ink after:absolute after:inset-0 group-hover:text-brand">{title}</a>
  </h3>
  <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-muted">{description}</p>
  <p class="font-mono text-xs text-muted">
    <FormattedDate date={publishedAt} />
    <span aria-hidden="true"> · </span>
    {minutes} min
  </p>
</article>
