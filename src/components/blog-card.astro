---
import FormattedDate from "./formatted-date.astro";
import TagList from "./tag-list.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  minutes: number;
  tags: string[];
}

const { href, title, description, pubDate, minutes, tags } = Astro.props;
---

<article class="card-hover group rounded-lg border border-white/10 p-5">
  <h3 class="font-semibold">
    <a href={href} class="text-ink group-hover:text-brand">{title}</a>
  </h3>
  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
  <p class="mt-2 text-xs text-muted">
    <FormattedDate date={pubDate} />
    <span aria-hidden="true"> · </span>
    {minutes} min
  </p>
  <TagList tags={tags} class="mt-3" />
</article>
