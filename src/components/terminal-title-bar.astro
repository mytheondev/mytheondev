---
import { NAV_ITEMS, navHref } from "../lib/site";

interface Props {
  home?: boolean;
  activeNav?: string;
  titlePath?: string;
}

const { home = false, activeNav, titlePath } = Astro.props;
---

<header
  id="site-header"
  class="sticky top-0 z-50 flex items-center gap-3 border-b border-white/10 bg-surface/80 px-3 py-2.5 backdrop-blur-md transition-transform duration-300 ease-out md:rounded-t-lg md:px-4"
>
  <!-- tw: -translate-y-full -->
  <div class="flex shrink-0 items-center gap-1.5" aria-hidden="true">
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
  </div>

  <p class="min-w-0 flex-1 truncate text-xs text-muted md:text-sm">
    <a href="/" class="text-ink hover:text-brand hover:decoration-brand">mytheon@dev</a>
    {titlePath ? `:${titlePath}` : " — zsh — 120×40"}
  </p>

  <nav class="hidden items-center gap-4 lg:flex" aria-label="Primary">
    {
      NAV_ITEMS.map((item) => (
        <a
          href={navHref(item.id, home)}
          data-nav-link={item.id}
          class:list={[
            "text-sm transition-colors hover:text-brand",
            activeNav === item.id ? "text-brand" : "text-ink",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <button
    type="button"
    id="menu-toggle"
    class="menu-toggle relative z-50 flex lg:hidden"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-overlay"
  >
    <span class="menu-toggle-bar" aria-hidden="true"></span>
    <span class="menu-toggle-bar" aria-hidden="true"></span>
    <span class="menu-toggle-bar" aria-hidden="true"></span>
  </button>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (header && !reduceMotion) {
    let lastY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";

      if (menuOpen || y < 16) {
        header.classList.remove("-translate-y-full");
        lastY = y;
        return;
      }

      if (Math.abs(y - lastY) < 8) return;

      header.classList.toggle("-translate-y-full", y > lastY);
      lastY = y;
    };

    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
