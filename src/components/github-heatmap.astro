---
import { HEATMAP_API_URL } from "../lib/github-heatmap";
---

<div id="github-heatmap" data-api={HEATMAP_API_URL}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <p class="text-sm text-muted">
      <span data-heatmap-total>—</span> contributions in the last year
    </p>
    <p class="text-sm text-muted">
      Best streak: <span data-heatmap-streak>—</span>
    </p>
  </div>

  <div data-heatmap-grid class="mt-5 min-w-0" aria-label="GitHub contribution heatmap"></div>

  <p data-heatmap-error class="mt-4 hidden text-sm text-brand" role="status"></p>

  <div class="mt-4 flex items-center justify-end gap-1 text-xs text-muted">
    <span>Less</span>
    <span class="size-2.5 rounded-full bg-brand/0 ring-1 ring-white/10"></span>
    <span class="size-2.5 rounded-full bg-brand/15"></span>
    <span class="size-2.5 rounded-full bg-brand/35"></span>
    <span class="size-2.5 rounded-full bg-brand/60"></span>
    <span class="size-2.5 rounded-full bg-brand"></span>
    <span>More</span>
  </div>
</div>

<script>
  import {
    bestStreak,
    HEATMAP_LEVEL_OPACITY,
    monthLabels,
    sumContributions,
    WEEKDAY_LABELS,
    weeksFromDays,
    type ContributionsResponse,
  } from "../lib/github-heatmap";

  const root = document.getElementById("github-heatmap");
  if (root) {
    const api = root.dataset.api ?? "";
    const totalEl = root.querySelector("[data-heatmap-total]");
    const streakEl = root.querySelector("[data-heatmap-streak]");
    const gridEl = root.querySelector("[data-heatmap-grid]");
    const errorEl = root.querySelector("[data-heatmap-error]");

    const showError = (message: string) => {
      if (!(errorEl instanceof HTMLElement)) return;
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    };

    const columns = (count: number) => `repeat(${count}, minmax(0, 1fr))`;

    const render = (data: ContributionsResponse) => {
      const days = data.contributions;
      if (days.length === 0) {
        showError("No contribution data for the last year.");
        return;
      }

      if (totalEl) totalEl.textContent = String(sumContributions(days));
      if (streakEl) streakEl.textContent = `${bestStreak(days)} days`;

      const weeks = weeksFromDays(days);
      const months = monthLabels(weeks);

      const layout = document.createElement("div");
      layout.className = "flex w-full min-w-0 items-stretch gap-2";

      const weekdays = document.createElement("div");
      weekdays.className = "flex w-8 shrink-0 flex-col";
      weekdays.setAttribute("aria-hidden", "true");

      const weekdaySpacer = document.createElement("div");
      weekdaySpacer.className = "h-4 shrink-0";

      const weekdayCol = document.createElement("div");
      weekdayCol.className = "grid flex-1 grid-rows-7 gap-1 text-[10px] leading-none text-muted";

      for (const label of WEEKDAY_LABELS) {
        const row = document.createElement("span");
        row.className = "flex items-center";
        row.textContent = label;
        weekdayCol.append(row);
      }

      weekdays.append(weekdaySpacer, weekdayCol);

      const chart = document.createElement("div");
      chart.className = "flex min-w-0 flex-1 flex-col gap-1";

      const labels = document.createElement("div");
      labels.className = "grid h-4 w-full gap-1 text-[10px] leading-none text-muted";
      labels.style.gridTemplateColumns = columns(weeks.length);
      labels.setAttribute("aria-hidden", "true");

      months.forEach((month, i) => {
        const next = months[i + 1];
        const maxSpan = (next ? next.index : weeks.length) - month.index;
        const span = Math.min(3, Math.max(1, maxSpan));
        const cell = document.createElement("span");
        cell.textContent = month.label;
        cell.className = "truncate";
        cell.style.gridColumn = `${month.index + 1} / span ${span}`;
        labels.append(cell);
      });

      const grid = document.createElement("div");
      grid.className = "grid w-full flex-1 gap-1 bg-surface";
      grid.style.gridTemplateColumns = columns(weeks.length);
      grid.style.gridTemplateRows = "repeat(7, minmax(0, 1fr))";
      grid.style.gridAutoFlow = "column";

      for (const week of weeks) {
        for (const day of week) {
          const cell = document.createElement("span");
          const level = Math.min(Math.max(day.level, 0), 4);
          const opacity = HEATMAP_LEVEL_OPACITY[level];
          cell.className =
            "aspect-square w-full min-h-0 rounded-xs ring-1 ring-white/10 md:rounded-sm";
          cell.style.backgroundColor =
            day.date === ""
              ? "transparent"
              : `color-mix(in oklab, var(--color-brand) ${opacity * 100}%, transparent)`;
          if (day.date) {
            cell.title = `${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`;
          }
          grid.append(cell);
        }
      }

      chart.append(labels, grid);
      layout.append(weekdays, chart);
      gridEl?.replaceChildren(layout);
    };

    const load = async () => {
      try {
        const response = await fetch(api);
        if (!response.ok) {
          if (response.status === 429) {
            throw new Error(
              `Rate limited (HTTP 429). The public contributions API limit may have been reached.`,
            );
          }
          throw new Error(`Could not load contributions (HTTP ${response.status}).`);
        }

        const data = (await response.json()) as ContributionsResponse;
        if (!data.contributions?.length) {
          showError("No contribution data returned.");
          return;
        }

        render(data);
      } catch (error) {
        if (error instanceof TypeError) {
          showError(
            "Request blocked or failed. A public API limit or an ad blocker may be blocking github-contributions-api.jogruber.de.",
          );
          return;
        }

        showError(error instanceof Error ? error.message : "Unknown error loading contributions.");
      }
    };

    void load();
  }
</script>
