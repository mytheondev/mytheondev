---
interface Props {
  eyebrow: string;
  title: string;
  as?: "h1" | "h2";
  size?: "lg" | "md";
  class?: string;
}

const { eyebrow, title, as: Tag = "h2", size = "lg", class: className } = Astro.props;
const hasAction = Astro.slots.has("action");
---

<div class:list={["flex flex-wrap items-end justify-between gap-4", className]}>
  <div class="flex flex-col gap-1.5">
    <p class="eyebrow">{eyebrow}</p>
    <Tag
      class:list={[
        "font-display font-semibold tracking-tight text-ink",
        size === "lg" ? "text-3xl leading-[1.05] md:text-[44px]" : "text-2xl md:text-[26px]",
      ]}
    >
      {title}
    </Tag>
  </div>
  {hasAction && <slot name="action" />}
</div>
