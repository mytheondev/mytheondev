---
import { tagHref } from "../lib/blog";

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-1.5", className]}>
  {
    tags.map((tag) => (
      <li>
        <a
          href={tagHref(tag)}
          class="relative z-10 inline-flex rounded-full bg-brand-soft px-2.5 py-1 text-xs font-medium text-ink transition-colors hover:text-brand"
        >
          {tag}
        </a>
      </li>
    ))
  }
</ul>
