---
import { NAV_ITEMS, navHref } from "../lib/site";

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

<div
  id="nav-overlay"
  class="absolute inset-0 z-40 hidden items-center justify-center bg-surface lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <!-- tw-animations: animate-fade-in animate-fade-out animate-fade-in-up -->
  <nav class="flex flex-col items-center justify-center gap-6 text-center" aria-label="Mobile">
    {
      NAV_ITEMS.map((item, index) => (
        <a
          href={navHref(item.id, home)}
          data-overlay-link
          class:list={[
            "animate-fade-in-up text-center text-3xl font-bold text-ink hover:text-brand",
            index === 0 && "animate-delay-50",
            index === 1 && "animate-delay-100",
            index === 2 && "animate-delay-150",
            index === 3 && "animate-delay-200",
            index === 4 && "animate-delay-250",
            index === 5 && "animate-delay-300",
            index === 6 && "animate-delay-300",
          ]}
        >
          {item.command}
        </a>
      ))
    }
  </nav>
</div>

<script>
  const overlay = document.getElementById("nav-overlay");
  const toggle = document.getElementById("menu-toggle");
  const links = overlay?.querySelectorAll<HTMLAnchorElement>("[data-overlay-link]");

  if (overlay && toggle) {
    let open = false;
    let lastFocus: HTMLElement | null = null;
    let hideTimer = 0;

    const focusables = () =>
      [toggle, ...Array.from(links ?? [])].filter(
        (el): el is HTMLElement => el instanceof HTMLElement,
      );

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const conceal = () => {
      window.clearTimeout(hideTimer);
      overlay.removeEventListener("animationend", onFadeOut);
      if (!open) {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
      }
    };

    const onFadeOut = (event: AnimationEvent) => {
      if (event.target !== overlay) return;
      conceal();
    };

    const setOpen = (next: boolean) => {
      open = next;
      document.body.style.overflow = open ? "hidden" : "";
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle.classList.toggle("is-open", open);

      if (open) {
        window.clearTimeout(hideTimer);
        overlay.removeEventListener("animationend", onFadeOut);
        overlay.classList.remove("hidden", "animate-fade-out");
        overlay.classList.add("flex", "animate-fade-in");
        links?.forEach((link) => {
          link.classList.remove("animate-fade-in-up");
          void link.offsetWidth;
          link.classList.add("animate-fade-in-up");
        });
        lastFocus = document.activeElement as HTMLElement | null;
        links?.[0]?.focus();
        return;
      }

      overlay.classList.remove("animate-fade-in");
      if (reduceMotion) {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        lastFocus?.focus();
        return;
      }

      overlay.classList.add("animate-fade-out");
      overlay.addEventListener("animationend", onFadeOut);
      hideTimer = window.setTimeout(conceal, 300);
      lastFocus?.focus();
    };

    toggle.addEventListener("click", () => setOpen(!open));

    links?.forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (!open) return;

      if (event.key === "Escape") {
        event.preventDefault();
        setOpen(false);
        return;
      }

      if (event.key !== "Tab") return;

      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (!first || !last) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  }
</script>
