---
import BlogCard from "../../components/blog-card.astro";
import SectionHeading from "../../components/section-heading.astro";
import Layout from "../../layouts/site.astro";
import { getEnglishPosts, readingMinutes } from "../../lib/blog";

const posts = (await getEnglishPosts()).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const title = "Blog — Mytheon";
const description =
  "Writing on Git, NestJS APIs, and JavaScript tooling — pnpm vs npm, security headers, logging, and OpenAPI notes from Mytheon.";
---

<Layout title={title} description={description} activeNav="blog">
  <section class="pt-10 md:pt-16">
    <SectionHeading eyebrow="Production notes" title="Blog" as="h1" />
    <p class="mt-4 mb-8 max-w-[68ch] text-base leading-relaxed text-muted md:text-lg">
      {description}
    </p>
    <p
      data-tag-filter
      class="mb-6 hidden w-fit items-center gap-3 rounded-full bg-brand-soft py-1.5 pr-1.5 pl-4 text-sm text-ink [&:not(.hidden)]:flex"
    >
      <span>Filtered by <strong class="font-semibold" data-tag-name></strong></span>
      <a
        href="/blog/"
        class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-ink hover:text-brand"
      >
        Clear
      </a>
    </p>
    <div class="grid gap-3 md:grid-cols-2 md:gap-4" data-blog-list>
      {
        posts.map((post) => (
          <div data-tags={post.data.tags.join(",")}>
            <BlogCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              publishedAt={post.data.publishedAt}
              minutes={readingMinutes(post.body, post.data.minutes)}
              tags={post.data.tags}
            />
          </div>
        ))
      }
    </div>
    <p data-tag-empty class="mt-4 hidden text-sm text-muted">No posts with that tag.</p>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const tag = params.get("tag");
  if (tag) {
    const filter = document.querySelector("[data-tag-filter]");
    const name = document.querySelector("[data-tag-name]");
    const empty = document.querySelector("[data-tag-empty]");
    const items = document.querySelectorAll<HTMLElement>("[data-tags]");
    let visible = 0;

    if (filter instanceof HTMLElement) filter.classList.remove("hidden");
    if (name) name.textContent = tag;

    for (const item of items) {
      const tags = (item.dataset.tags ?? "").split(",");
      const match = tags.includes(tag);
      item.classList.toggle("hidden", !match);
      if (match) visible += 1;
    }

    if (visible === 0 && empty instanceof HTMLElement) {
      empty.classList.remove("hidden");
    }
  }
</script>
