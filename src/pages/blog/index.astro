---
import { getCollection } from "astro:content";
import BlogCard from "../../components/blog-card.astro";
import SectionPrompt from "../../components/section-prompt.astro";
import Layout from "../../layouts/terminal.astro";
import { readingMinutes } from "../../lib/blog";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = "Blog — Mytheon";
const description =
  "Writing on Git, NestJS APIs, and JavaScript tooling — pnpm vs npm, security headers, logging, and OpenAPI notes from Mytheon.";
---

<Layout title={title} description={description} activeNav="blog" titlePath="~/blog">
  <section>
    <SectionPrompt
      command="~ ls blog/*.md"
      comment="all posts, rendered from content collections"
    />
    <h1 class="mb-3 text-3xl font-bold tracking-tight">Blog</h1>
    <p class="mb-8 max-w-[68ch] text-base leading-7 text-muted">{description}</p>
    <p data-tag-filter class="mb-6 hidden text-sm text-muted">
      Filtered by <span data-tag-name></span>
      <a
        href="/blog/"
        class="ml-3 text-brand underline decoration-brand/40 underline-offset-4 hover:decoration-brand"
      >
        clear
      </a>
    </p>
    <div class="grid gap-4" data-blog-list>
      {
        posts.map((post) => (
          <div data-tags={post.data.tags.join(",")}>
            <BlogCard
              href={`/blog/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              minutes={readingMinutes(post.body, post.data.minutes)}
              tags={post.data.tags}
            />
          </div>
        ))
      }
    </div>
    <p data-tag-empty class="mt-4 hidden text-sm text-muted">No posts with that tag.</p>
  </section>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const tag = params.get("tag");
  if (tag) {
    const filter = document.querySelector("[data-tag-filter]");
    const name = document.querySelector("[data-tag-name]");
    const empty = document.querySelector("[data-tag-empty]");
    const items = document.querySelectorAll<HTMLElement>("[data-tags]");
    let visible = 0;

    if (filter instanceof HTMLElement) filter.classList.remove("hidden");
    if (name) name.textContent = tag;

    for (const item of items) {
      const tags = (item.dataset.tags ?? "").split(",");
      const match = tags.includes(tag);
      item.classList.toggle("hidden", !match);
      if (match) visible += 1;
    }

    if (visible === 0 && empty instanceof HTMLElement) {
      empty.classList.remove("hidden");
    }
  }
</script>
