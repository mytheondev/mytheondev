---
import { render } from "astro:content";
import BlogPost from "../../layouts/blog-post.astro";
import {
  adjacentPosts,
  getRoutablePosts,
  readingMinutes,
  relatedPosts,
  shouldShowToc,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getRoutablePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const posts = await getRoutablePosts();
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body, post.data.minutes);
const showToc = shouldShowToc(headings, minutes);
const { older, newer } = adjacentPosts(post, posts);
const related = relatedPosts(post, posts).filter(
  (item) => item.id !== older?.id && item.id !== newer?.id,
);
---

<BlogPost
  post={post}
  minutes={minutes}
  headings={headings}
  showToc={showToc}
  related={related}
  older={older}
  newer={newer}
>
  <Content />
</BlogPost>
