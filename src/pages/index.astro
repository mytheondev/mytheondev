---
import BlogCard from "../components/blog-card.astro";
import BlinkingCursor from "../components/blinking-cursor.astro";
import CopyEmail from "../components/copy-email.astro";
import ExperienceCard from "../components/experience-card.astro";
import GithubHeatmap from "../components/github-heatmap.astro";
import ProjectCard from "../components/project-card.astro";
import SectionPrompt from "../components/section-prompt.astro";
import Typewriter from "../components/typewriter.astro";
import Layout from "../layouts/terminal.astro";
import { getFeaturedProjects } from "../lib/github-projects";
import { GITHUB_URL, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE } from "../lib/site";
import { getCollection } from "astro:content";

const projects = await getFeaturedProjects();
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const stack = ["NestJS", "Go", "Vue", "Nuxt", "TypeScript"];

const reveal = "animate-fade-in-up timeline-view animate-range-entry border-t border-white/5 py-16";
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} home>
  <section id="about">
    <SectionPrompt
      command="~ whoami → About"
      comment="identity dump — name, role, and what I build"
    />
    <p class="text-sm text-muted">mytheon</p>
    <Typewriter
      text="Full Stack Engineer"
      class="mt-2 text-3xl font-bold tracking-tight md:text-5xl"
    />
    <h2 class="sr-only">About</h2>
    <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
      Full Stack Engineer with 10+ years of experience designing and building scalable end-to-end
      systems. I care about architecture, clean code, and shipping robust applications on both
      backend and frontend. Currently building with:
    </p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        stack.map((item) => (
          <li class="rounded-md border border-white/10 px-2.5 py-1 text-xs text-ink">{item}</li>
        ))
      }
    </ul>
  </section>

  <section id="projects" class={reveal}>
    <SectionPrompt
      command="~ ls -la projects/"
      comment="featured repositories, fetched at build time"
    />
    <h2 class="mb-6 text-xl font-semibold">Projects</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section id="experience" class={reveal}>
    <SectionPrompt
      command="~ cat experience.log"
      comment="roles, dates, and the stacks behind them"
    />
    <h2 class="mb-6 text-xl font-semibold">Experience</h2>
    <div class="space-y-4">
      <ExperienceCard
        role="Full Stack Engineer"
        company="Interseguro"
        dates="2026, present"
        description="Part of the Customer Experience squad, developing end-to-end solutions that directly impact the user. I work on frontend and backend, collaborating with the team to build maintainable, scalable, user-centered digital products."
        stack={[
          "Go",
          "TypeScript",
          "Node.js",
          "Vue",
          "MongoDB",
          "Tailwind CSS",
          "PostgreSQL",
          "Docker",
          "GCP",
        ]}
      />
      <ExperienceCard
        role="Full Stack Developer"
        company="Nativos Digitales"
        dates="2016 – 2025"
        description="Built and maintained web applications across the entire stack. Developed features using Astro, Next.js, React, .NET and Node.js, integrated with PostgreSQL, MySQL and SQL Server, collaborating with the team to deliver projects on time — from UI components to APIs and databases."
        stack={[
          "TypeScript",
          "Astro",
          "Next.js",
          "React",
          ".NET",
          "NestJS",
          "Symfony",
          "PostgreSQL",
          "MySQL",
          "SQL Server",
          "Prisma",
          "Docker",
        ]}
      />
    </div>
  </section>

  <section id="github" class={reveal}>
    <SectionPrompt
      command="~ curl api.github.com/stats"
      comment="public contribution graph for mytheondev"
    />
    <h2 class="mb-6 text-xl font-semibold">GitHub</h2>
    <GithubHeatmap />
  </section>

  <section id="blog" class={reveal}>
    <SectionPrompt
      command="~ ls blog/*.md"
      comment="latest notes — indexable markdown, no client fetch"
    />
    <h2 class="mb-6 text-xl font-semibold">Blog</h2>
    <div class="grid gap-4">
      {
        posts.map((post) => (
          <BlogCard
            href={`/blog/${post.id}/`}
            title={post.data.title}
            pubDate={post.data.pubDate}
            minutes={post.data.minutes}
            tags={post.data.tags}
          />
        ))
      }
    </div>
    <p class="mt-6">
      <a
        href="/blog/"
        class="text-sm text-brand underline decoration-brand/40 underline-offset-4 hover:decoration-brand"
      >
        View all posts →
      </a>
    </p>
  </section>

  <section id="contact" class={reveal}>
    <SectionPrompt
      command="~ cat contact.md"
      comment="open a channel — email copies to the clipboard"
    />
    <h2 class="mb-6 text-xl font-semibold">Contact</h2>
    <div class="rounded-lg border border-white/10 p-5 md:p-6">
      <ul class="space-y-4 text-sm">
        <li>
          <a
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink underline decoration-white/20 underline-offset-4 hover:text-brand hover:decoration-brand"
          >
            github.com/mytheondev
          </a>
        </li>
        <li>
          <a
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink underline decoration-white/20 underline-offset-4 hover:text-brand hover:decoration-brand"
          >
            linkedin.com/in/mytheon
          </a>
        </li>
        <li>
          <CopyEmail />
        </li>
      </ul>
    </div>
  </section>

  <footer class="mt-16 border-t border-white/5 pt-8 text-sm text-muted">
    <p>
      © 2026 mytheon.dev · code, coffee ☕ and love. · Astro · Tailwind CSS · TypeScript
      <BlinkingCursor />
    </p>
  </footer>
</Layout>
