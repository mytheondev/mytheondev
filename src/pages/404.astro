---
import Layout from "../layouts/site.astro";

const title = "404 — Mytheon";
const description = "This path is not in the tree.";
const links = [
  { href: "/", label: "Home", primary: true },
  { href: "/blog/", label: "Blog", primary: false },
  { href: "/projects/", label: "Projects", primary: false },
];
---

<Layout title={title} description={description} robots="noindex">
  <section class="flex min-h-[60svh] flex-col items-start justify-center gap-6 py-16">
    <p class="eyebrow">Error 404</p>
    <h1
      class="font-display text-[96px] leading-[0.9] font-bold tracking-[-0.05em] text-brand md:text-[160px]"
    >
      404
    </h1>
    <p class="max-w-[48ch] text-lg leading-relaxed text-muted md:text-xl">{description}</p>
    <ul class="flex flex-wrap gap-2.5">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class={link.primary ? "pill-primary" : "pill-secondary"}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
