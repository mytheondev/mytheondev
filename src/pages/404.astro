---
import SectionPrompt from "../components/section-prompt.astro";
import Layout from "../layouts/terminal.astro";

const title = "404 — Mytheon";
const description = "This path is not in the tree.";
const links = [
  { href: "/", label: "Home" },
  { href: "/blog/", label: "Blog" },
  { href: "/projects/", label: "Projects" },
];
---

<Layout title={title} description={description} titlePath="~/404" robots="noindex">
  <section>
    <SectionPrompt command="~ cat 404" comment="no such file or directory" />
    <h1 class="mb-3 text-3xl font-bold tracking-tight">404</h1>
    <p class="mb-8 max-w-[68ch] text-base leading-7 text-muted">{description}</p>
    <ul class="flex flex-wrap gap-x-4 gap-y-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm text-ink underline decoration-white/20 underline-offset-4 hover:text-brand hover:decoration-brand"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
